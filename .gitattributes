# Normalize line endings in the repository; check out with the platform's native endings.
* text=auto

*.java text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.properties text eol=lf
mvnw   text eol=lf
*.sh   text eol=lf

# Windows scripts keep CRLF.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

*.jar  binary
*.png  binary
*.zip  binary
